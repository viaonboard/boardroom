{
  "name": "@onboard/boardroom",
  "version": "1.0.0",
  "description": "A dynamic, configurable dashboard widget system built with React, TypeScript, and GridStack",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "react",
    "dashboard",
    "widget",
    "gridstack",
    "typescript",
    "drag-drop",
    "charts",
    "metrics"
  ],
  "author": "Onboard Team",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "gridstack": "^8.4.0",
    "lucide-react": "^0.263.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^1.14.0",
    "sonner": "^1.0.0",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "rollup": "^3.20.0",
    "rollup-plugin-dts": "^5.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/onboard/boardroom.git"
  },
  "bugs": {
    "url": "https://github.com/onboard/boardroom/issues"
  },
  "homepage": "https://github.com/onboard/boardroom#readme"
} 